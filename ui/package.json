{
  "name": "hipaa-audit-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser interface for the HIPAA audit assistant",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
