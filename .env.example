# Copy to .env and fill in. Never commit .env.
# Variables already set in the environment win over this file.

# --- Reviewer ---------------------------------------------------------------------------------------------------------
# "anthropic" sends the retrieved passages for each control to the Anthropic API and needs a key.
# "heuristic" runs offline with no key. It is a keyword locator, not an AI model, and is meant for trying the tool out.
HIPAA_AUDIT_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
HIPAA_AUDIT_MODEL=claude-sonnet-5-5
# How much the model may think per control: low, medium, high, xhigh or max. "default" leaves the choice to the API.
HIPAA_AUDIT_EFFORT=medium

# --- Retrieval --------------------------------------------------------------------------------------------------------
# "auto" uses fastembed when it is installed (pip install ".[embeddings]") and the built-in hashing embedder otherwise.
HIPAA_AUDIT_EMBEDDER=auto
# Passages sent to the reviewer for each control.
HIPAA_AUDIT_TOP_K=6

# --- Storage and limits -----------------------------------------------------------------------------------------------
HIPAA_AUDIT_DB_PATH=./data/audits.sqlite3
HIPAA_AUDIT_MAX_UPLOAD_MB=10
HIPAA_AUDIT_MAX_PAGES=200
# Controls assessed at the same time within one review.
HIPAA_AUDIT_CONCURRENCY=4
# Reviews that may run at the same time. Each one makes up to HIPAA_AUDIT_CONCURRENCY model calls at once.
HIPAA_AUDIT_MAX_ACTIVE_AUDITS=2
# Reuse an earlier answer when the passages, the control and the prompt version are all unchanged.
HIPAA_AUDIT_CACHE=true
# Delete reviews (text, findings and cached answers) older than this many days when the server starts. 0 keeps them.
HIPAA_AUDIT_RETENTION_DAYS=0

# --- Access and serving -----------------------------------------------------------------------------------------------
# Require this value in the X-API-Key header on every /api request except /api/health. Set one before exposing the server.
HIPAA_AUDIT_API_KEY=
# The bundled interface is served by the same process, so no CORS setting is needed. Add comma-separated origins only if
# another site must call the API from a browser.
# HIPAA_AUDIT_CORS_ORIGINS=
# Folder holding a built interface (index.html and assets). Defaults to ui/dist in a source checkout.
# HIPAA_AUDIT_STATIC_DIR=
