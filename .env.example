# Copy to .env and fill in. Never commit .env.

# LLM backend: "anthropic" (real model, needs a key) or "heuristic" (offline keyword demo, no key, not an AI model)
HIPAA_AUDIT_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
HIPAA_AUDIT_MODEL=claude-sonnet-5-5
# How much the model may think per control: low, medium, high, xhigh, max, or "default" to let the API decide
HIPAA_AUDIT_EFFORT=medium

# Retrieval: "auto" uses fastembed if installed, otherwise the hashing fallback
HIPAA_AUDIT_EMBEDDER=auto

# Storage and limits
HIPAA_AUDIT_DB_PATH=./data/audits.sqlite3
HIPAA_AUDIT_MAX_UPLOAD_MB=10
HIPAA_AUDIT_MAX_PAGES=200
HIPAA_AUDIT_CONCURRENCY=4

# Optional: require this value in the X-API-Key header on every /api request
HIPAA_AUDIT_API_KEY=

# Optional: comma-separated browser origins allowed by CORS (the bundled UI is same-origin)
HIPAA_AUDIT_CORS_ORIGINS=http://localhost:5173
